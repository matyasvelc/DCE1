# Copy to .env and adjust. docker compose reads .env automatically.

# Registry/namespace the images are tagged with and pushed to, e.g.
#   docker.io/<dockerhub-user>
#   <kiv-gitlab-registry-host>/<group>/<project>
REGISTRY=docker.io/changeme
TAG=latest

# Database
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
DB_HOST_PORT=5432
# Load sample data on first start (only when the items table is empty)
DB_SEED=true

# Frontend
FRONTEND_PORT=8080
FRONTEND_SECRET_KEY=change-me
DISPLAY_TZ=Europe/Prague

LOG_LEVEL=INFO
